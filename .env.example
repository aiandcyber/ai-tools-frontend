# Local development (leave VITE_API_BASE empty so Vite proxies /api → VITE_API_TARGET)
VITE_API_BASE=
VITE_API_TARGET=http://127.0.0.1:8000

# Production (Cloudflare Pages → set these as build environment variables)
# VITE_API_BASE=https://api.tools.ai-forall.org

# Auth0 SPA (same tenant as construction; Tools has its own Client ID)
VITE_AUTH0_DOMAIN=
VITE_AUTH0_CLIENT_ID=
VITE_AUTH0_AUDIENCE=https://api.ai-forall.org
# When true: LLM features (chat, summarize, translate, …) require Sign in
VITE_AUTH_REQUIRED=true
VITE_PORTAL_URL=https://ai-forall.org

# Cloudflare Turnstile (public sitekey). Local dummy always passes.
# Production: real widget sitekey for tools.ai-forall.org
VITE_TURNSTILE_SITEKEY=1x00000000000000000000AA

# Isolated virus-analysis VM (browser POSTs here; not through Tools API)
# VITE_SCAN_BASE=https://34-19-57-31.sslip.io
